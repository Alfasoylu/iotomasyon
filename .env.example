DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
SESSION_SECRET="replace-with-a-random-32-plus-character-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Phase 27 — Product Media Studio (Supabase Storage)
# Create a "product-images" bucket in your Supabase project (Storage → New bucket → product-images → Public)
# SUPABASE_URL is the project URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is the service_role key (Settings → API → service_role)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# ── PDKS (Personel Devam Kontrol) Web Push ──────────────────────────────────
# VAPID anahtar çifti: `npx web-push generate-vapid-keys` ile üretin.
# PDKS_VAPID_PUBLIC_KEY istemciye gönderilir (gizli değil); private SECRET'tir.
# PDKS_VAPID_SUBJECT bir mailto: veya https URL olmalı (push servis sağlayıcı iletişimi).
PDKS_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
PDKS_VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
PDKS_VAPID_SUBJECT="mailto:admin@yourdomain.com"

# ── /login ve /kayit CAPTCHA ─────────────────────────────────────────────────
# VARSAYILAN: yerleşik resim CAPTCHA'sı (lib/captcha.ts) — hiçbir anahtar gerekmez,
# imza için SESSION_SECRET kullanılır (istenirse ayrı CAPTCHA_SECRET tanımlanabilir).
# OPSİYONEL: Cloudflare Turnstile anahtarları tanımlanırsa yerleşik olan yerine o kullanılır.
# https://dash.cloudflare.com → Turnstile → Add widget (domain: iotomasyon.com).
# Yerel geliştirme için Cloudflare'ın "her zaman geçer" test anahtarları:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"
# TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"
# CAPTCHA_SECRET="optional-separate-secret-for-image-captcha"

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Mesaj GÖNDERME ve GELEN CEVAPLARI KAYDETME. alfashome backend'i yalnız
# gönderir; cevaplar TEK adreste toplanır çünkü Meta her numara için TEK
# callback URL kabul eder — o adres burasıdır (/api/whatsapp/webhook).
#
# WHATSAPP_TOKEN          : Sistem Kullanıcısı'ndan alınan SÜRESİZ anahtar.
#                           Geçici anahtar 24 saatte ölür ve mesajlar SESSİZCE durur.
# WHATSAPP_PHONE_NUMBER_ID: Meta → WhatsApp → API Kurulumu'ndaki numara kimliği
#                           (telefon numarasının kendisi DEĞİL).
# WHATSAPP_APP_SECRET     : Uygulama Ayarları → Temel → Uygulama Gizli Anahtarı.
#                           Webhook imzasını (X-Hub-Signature-256) doğrular.
#                           YOKSA webhook 503 döner — imzasız kayıt KABUL EDİLMEZ,
#                           yoksa isteyen istediği "cevabı" sisteme yazdırabilirdi.
# WHATSAPP_VERIFY_TOKEN   : Webhook'u Meta paneline tanıtırken girilen serbest
#                           metin; ikisi birebir aynı olmalı.
# WHATSAPP_TEMPLATE_LANG  : Onaylı şablonun dil kodu (tr / en_US).
WHATSAPP_TOKEN="replace-with-permanent-system-user-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-phone-number-id"
WHATSAPP_APP_SECRET="replace-with-app-secret"
WHATSAPP_VERIFY_TOKEN="replace-with-a-random-string"
WHATSAPP_TEMPLATE_LANG="tr"

# WhatsApp zamanlanmış mesajlar — tetikleme
# /api/cron/whatsapp-schedules `vercel.json`'a EKLENMEZ: Vercel Hobby yalnız
# günlük cron'a izin veriyor ve iki günlük cron zaten dolu; bu görev gün içinde
# saat başı kontrol edilmeli. PDKS hatırlatmalarındaki yolun aynısı — harici bir
# zamanlayıcı (cron-job.org / GitHub Actions) saat başı çağırır:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<domain>/api/cron/whatsapp-schedules
# CRON_SECRET zaten mevcut cron'lar için tanımlı; ayrı bir değişken gerekmez.

# ── Meta reklam paneli (/reklamlar) ─────────────────────────────────────────
# SALT OKUNUR: panel yalnız performans gösterir; bütçe/durum değiştirmez.
# META_ADS_TOKEN      : `ads_read` izinli SİSTEM KULLANICISI anahtarı.
#                       ⚠️ Geçici anahtar 24 saatte ölür ve panel bir anda
#                       boşalır — süresiz anahtar alın.
# META_AD_ACCOUNT_ID  : Reklam hesabı kimliği. `act_1234567890` ya da yalnız
#                       rakam; kod ikisini de kabul eder.
META_ADS_TOKEN="replace-with-system-user-token-with-ads_read"
META_AD_ACCOUNT_ID="act_0000000000"
