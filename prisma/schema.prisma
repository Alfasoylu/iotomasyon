generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
  OPERATIONS
  WAREHOUSE
  MARKETPLACE_OPERATOR
  CUSTOM
}

// Phase 42 — Stock Adjustment Log
enum StockAdjustmentType {
  RESTOCK // Supplier delivery / stock giriş
  CORRECTION // Manual count correction / sayım düzeltme
  DAMAGE // Damaged/defective / hasar/fire
  RETURN // Customer return / müşteri iadesi
  SALE // Manual sale record / manuel satış kaydı
  OTHER // Diğer
}

enum InterestStatus {
  NEW
  WAITING_STOCK
  CONTACTED
  QUOTED
  WON
  LOST
  CANCELLED
}

enum InterestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum CustomerStatus {
  NEW
  CONTACTED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum InterestStage {
  INTERESTED
  PRICE_SENT
  NEGOTIATING
  WAITING
  ORDERED
  CANCELLED
}

enum NoteType {
  NOTE
  CALL
  MEETING
  EMAIL
  WHATSAPP
  QUOTE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  WON
  LOST
  ACCEPTED
  DECLINED
}

enum QuoteCurrencyMode {
  USD
  TRY
  BOTH
}

enum OutreachStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum CustomerType {
  TOPTAN
  PERAKENDE
  SITE_YONETICISI
  GUVENLIK_SIRKETI
  MAGAZA
  ONLINE_SATICI
  CUSTOM
}

// Phase 98 — Müşteri çatı segmentasyonu
// B2B_RESELLER: bayi/güvenlik şirketi/nalbur — sürekli alır, sürekli temas
// INSTALLATION: cafe/restoran/site yönetimi/ofis — tek seferlik montaj
// MARKETPLACE:  Entegra'dan gelen pazaryeri müşterileri
enum CustomerSegment {
  B2B_RESELLER
  INSTALLATION
  MARKETPLACE
}

// Phase 99 — Sektör hiyerarşisi
// Ana grup: "Güvenlik Bayisi" → Alt: "Tedarikçi", "Kurulum", vb.
// Customer'a tek industryId atanır (alt sektör), grup parent üzerinden bulunur.
model Industry {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Industry?  @relation("IndustryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Industry[] @relation("IndustryHierarchy")
  customers Customer[]
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  @@index([parentId])
  @@index([slug])
}

enum StockSource {
  MANUAL
  XML
  API
  IMPORT
}

enum XmlSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  ERROR
}

enum MarketplacePlatform {
  TRENDYOL
  HEPSIBURADA
  N11
  PTTAVM
  KOCTAS
  TEKNOSA
  TEMU
  CUSTOM
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  UNKNOWN
}

enum StockConfidence {
  HIGH
  MEDIUM
  LOW
}

// Phase 11A — Product classification
enum ProductKind {
  MAIN_STOCK // physical inventory product
  LISTING_PACKAGE // marketplace listing / variant / bundle product
}

// Phase 71 — Canonical marketplace price registry
enum PriceMarketplace {
  TRENDYOL
  HEPSIBURADA
  AMAZON
  N11
  PAZARAMA
  IDEFIX
  WEBSITE
  OTHER
}

enum PriceSource {
  XML
  API
  MANUAL
}

model MarketplacePrice {
  id               String           @id @default(cuid())
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplace      PriceMarketplace
  priceTry         Decimal          @db.Decimal(15, 2)
  currency         String           @default("TRY")
  source           PriceSource      @default(XML)
  rawExternalValue Decimal?         @db.Decimal(15, 4)
  updatedAt        DateTime         @updatedAt
  createdAt        DateTime         @default(now())

  @@unique([productId, marketplace])
  @@index([productId])
  @@index([marketplace])
}

model ProductAttribute {
  id                String                       @id @default(cuid())
  name              String                       @unique
  createdAt         DateTime                     @default(now())
  products          ProductAttributeAssignment[]
  customerInterests CustomerAttributeInterest[]

  @@index([name])
}

model ProductAttributeAssignment {
  productId   String
  attributeId String
  createdAt   DateTime         @default(now())
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
}

model CustomerAttributeInterest {
  customerId  String
  attributeId String
  createdAt   DateTime         @default(now())
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([customerId, attributeId])
  @@index([customerId])
  @@index([attributeId])
}

enum RecipientStatus {
  PENDING
  SENT
  REPLIED
  QUOTED
  WON
  LOST
}

// ── RBAC models ─────────────────────────────────────────────────

// System and custom role metadata + default permission mapping.
// key must match a UserRole enum value exactly.
// isSystem=true rows cannot be deleted via admin UI.
model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
}

// Canonical permission registry.
// Dangerous permissions (migrations.approve, destructiveActions.approve)
// must never appear in RolePermission rows — UserPermission only.
model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  category        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([category])
}

// Default permissions per role.
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Per-user permission overrides.
// granted=true  → explicit grant  (overrides role defaults)
// granted=false → explicit deny   (overrides role defaults and grants)
// Dangerous permissions: only path to access — no role default applies.
model UserPermission {
  userId       String
  permissionId String
  granted      Boolean
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model User {
  id                       String                         @id @default(cuid())
  email                    String                         @unique
  passwordHash             String
  name                     String
  role                     UserRole                       @default(ADMIN)
  isActive                 Boolean                        @default(true)
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  // RBAC — no new column; relation only
  userPermissions          UserPermission[]
  // existing relations unchanged
  productsCreated          Product[]                      @relation("CreatedProducts")
  stockCountedProducts     Product[]                      @relation("StockCountedBy")
  notesCreated             Note[]
  interestsCreated         ProductInterest[]              @relation("CreatedInterests")
  interestsOwned           ProductInterest[]              @relation("AssignedInterests")
  tasksCreated             FollowUpTask[]                 @relation("CreatedTasks")
  tasksOwned               FollowUpTask[]                 @relation("AssignedTasks")
  quotesCreated            Quote[]
  categoryInterestsCreated CategoryInterest[]             @relation("CreatedCategoryInterests")
  campaignsCreated         OutreachCampaign[]             @relation("CreatedCampaigns")
  customersOwned           Customer[]                     @relation("OwnedCustomers")
  savedViews               SavedView[]                    @relation("UserSavedViews")
  leadLists                LeadList[]                     @relation("UserLeadLists")
  messageTemplates         MessageTemplate[]              @relation("CreatedMessageTemplates")
  capitalConfigs           CapitalConfig[]
  marketplaceListings      MarketplaceListing[]           @relation("ListingResponsible")
  marketplaceMappings      MarketplaceProductMapping[]    @relation("MappingCreatedBy")
  questionActionLogs       MarketplaceQuestionActionLog[] @relation("QuestionActionUser")
  returnActionLogs         MarketplaceReturnActionLog[]   @relation("ReturnActionUser")
  quoteTemplates           QuoteTemplate[]                @relation("TemplatesCreated")
  marketplacePolicies      MarketplacePlatformPolicy[]    @relation("PolicyUpdatedBy")
  importDecisionSnapshots  ImportDecisionSnapshot[]       @relation("SnapshotCreatedBy")
  stockAdjustments         StockAdjustmentLog[]           @relation("AdjustmentCreatedBy")
  purchaseOrders           PurchaseOrder[]                @relation("PurchaseOrderCreatedBy") // Phase 77
  physicalCounts           Product[]                      @relation("PhysicalCountBy") // Phase 89
  catalogSharesSent        CatalogShare[]                 @relation("CatalogSharesSentBy") // Faz 4
}

model ProductCategory {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String?
  parentId    String?
  parent      ProductCategory?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[]  @relation("CategoryTree")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  products    Product[]
  interests   CategoryInterest[]
  campaigns   OutreachCampaign[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id                            String                       @id @default(cuid())
  sku                           String                       @unique
  barcode                       String?                      @unique
  name                          String
  imageUrl                      String?
  category                      String?
  categoryId                    String?
  brand                         String?
  model                         String?
  supplier                      String?
  stockQuantity                 Int                          @default(0)
  minimumStock                  Int                          @default(0)
  reorderLeadTime               Int?
  stockSource                   StockSource?
  stockConfidence               StockConfidence?
  lastStockSyncAt               DateTime?
  lastStockCountById            String?
  lastStockCountBy              User?                        @relation("StockCountedBy", fields: [lastStockCountById], references: [id], onDelete: SetNull)
  location                      String?
  description                   String?
  isActive                      Boolean                      @default(true)
  shippingCost                  Decimal?
  shippingCostOverride          Decimal?
  marketplaceCommission         Decimal?
  marketplaceCommissionOverride Decimal?
  importDate                    DateTime?
  importQuantity                Int?
  importUnitCostUsd             Decimal?
  inventoryCountDate            DateTime?
  inventoryCountStock           Int?
  // Phase 8 — Profitability Engine
  unitCostTry                   Decimal?
  sellingPriceTry               Decimal?
  wholesalePriceTry             Decimal?
  marketplacePriceTry           Decimal?
  // Faz 2 — Catalog USD net prices (KDV hariç) — sales rep katalog için
  wholesalePriceUsd             Decimal?                     @db.Decimal(12, 2)
  retailPriceUsd                Decimal?                     @db.Decimal(12, 2)
  // Catalog sıralama: default 1000 = otomatik (sıralamada en sonda eşit, stockQty+name ile bölünür).
  // 1-999 = manuel öncelik (küçük sayı önce listelenir).
  catalogSortOrder              Int                          @default(1000)
  packagingCost                 Decimal?
  vatRate                       Decimal?
  paymentFeeRate                Decimal?
  returnReserveRate             Decimal?
  // Phase 9 — Sales Potential Engine
  onlineSalesPotential          Int?
  wholesaleSalesPotential       Int?
  installerSalesPotential       Int?
  // Phase 11 — XML Sync override protection
  xmlLocked                     Boolean                      @default(false)
  // Phase 11A — XML import tracking
  xmlImported                   Boolean                      @default(false)
  // Phase 11A — Product classification
  productKind                   ProductKind                  @default(MAIN_STOCK)
  mainProductId                 String? // for LISTING_PACKAGE → main stock product
  mainProduct                   Product?                     @relation("ProductHierarchy", fields: [mainProductId], references: [id], onDelete: SetNull)
  variantProducts               Product[]                    @relation("ProductHierarchy")
  // Phase 16 — USD cost for import-priced products (do NOT remove unitCostTry)
  unitCostUsd                   Decimal?
  // Phase 11C — Import decision inputs
  weightKg                      Decimal?
  customsRatePct                Decimal?
  shippingMethodPref            String?
  // Phase 31 — RMB-first import economics
  sourceCostRmb                 Decimal?                     @db.Decimal(15, 2) // Purchase cost in RMB/CNY
  importPaymentFeePct           Decimal?                     @db.Decimal(5, 2) // Payment commission % (e.g. 3.0)
  source1688Url1                String?
  source1688Url2                String?
  // GTİP kodları — 3 adet, çünkü bazı ürünler farklı GTİP'lerle ithal edilebilir
  // (örn. bir kamera seti hem 8525.81 hem 8517.62 dilimine girebilir).
  // Format: "8525.81.00.00" gibi 12 haneli string (ondalık opsiyonel). NULL ise atanmamış.
  // Açıklama alanları: ilgili GTİP'in TGTC tarifesindeki resmi tanımı (operatör kolaylığı için).
  gtip1                         String?
  gtip1Desc                     String?
  gtip2                         String?
  gtip2Desc                     String?
  gtip3                         String?
  gtip3Desc                     String?
  // Phase 89 — Physical count (warehouse-managed, distinct from Entegra stockQuantity).
  // stockQuantity = source-of-truth from Entegra XML sync; never mutated by warehouse staff.
  // physicalCountQuantity = last physical count recorded in warehouse; variance = stockQuantity - physicalCountQuantity.
  physicalCountQuantity         Int?
  physicalCountAt               DateTime?
  physicalCountById             String?
  physicalCountBy               User?                        @relation("PhysicalCountBy", fields: [physicalCountById], references: [id], onDelete: SetNull)
  physicalCountNote             String?
  createdById                   String?
  createdBy                     User?                        @relation("CreatedProducts", fields: [createdById], references: [id], onDelete: SetNull)
  productCategory               ProductCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  interests                     ProductInterest[]
  notes                         Note[]
  tasks                         FollowUpTask[]
  quoteItems                    QuoteItem[]
  campaigns                     OutreachCampaign[]
  attributeAssignments          ProductAttributeAssignment[]
  marketplaceListings           MarketplaceListing[]
  marketplaceMappings           MarketplaceProductMapping[]
  quoteTemplateItems            QuoteTemplateItem[]          @relation("TemplateItems")
  // Phase 11A — multi-image support
  images                        ProductImage[]
  // Phase 11A — XML source data
  xmlData                       XmlProductData?
  // Phase 20 — supplier links
  supplierLinks                 SupplierProduct[]
  // Phase 93 â€” scalable product source links (1688 and other procurement URLs)
  sourceLinks                   ProductSourceLink[]
  // Phase 26 — Trendyol sales records
  trendyolSalesRecords          TrendyolSalesRecord[]
  // Phase 28 — Owner-only private intelligence (EXECUTIVE_READ only)
  privateNote                   String?
  // Phase 29 — Trendyol return/claim records
  trendyolReturnRecords         TrendyolReturnRecord[]
  // Hepsiburada (paralel mimari — read-only)
  hepsiburadaSalesRecords       HepsiburadaSalesRecord[]     @relation("HbSalesProduct")
  hepsiburadaReturnRecords      HepsiburadaReturnRecord[]    @relation("HbReturnsProduct")
  // Phase 92 — Generic marketplace sales (Entegra ihracı)
  marketplaceSalesRecords       MarketplaceSalesRecord[]     @relation("MarketplaceSalesProduct")
  // Phase 32 — Import decision snapshots
  importDecisionSnapshots       ImportDecisionSnapshot[]
  // Phase 42 — Stock adjustment log
  stockAdjustments              StockAdjustmentLog[]
  // Phase 49 — XML stock change log (Entegra ERP sync deltas)
  xmlStockChangeLogs            XmlStockChangeLog[]
  // Phase 71 — Canonical marketplace prices
  marketplacePrices             MarketplacePrice[]
  // Phase 77 — Purchase order line items
  purchaseOrderItems            PurchaseOrderItem[]
  // Faz 4 — Katalog ürün ilgi event'leri
  catalogInterests              CatalogProductInterest[]

  @@index([name])
  @@index([barcode])
  @@index([category])
  @@index([categoryId])
  @@index([supplier])
  @@index([stockSource])
  @@index([stockConfidence])
  @@index([lastStockCountById])
  @@index([stockQuantity, minimumStock])
  @@index([mainProductId])
  @@index([productKind])
  @@index([physicalCountAt])
  @@index([physicalCountById])
}

model Customer {
  id                      String                       @id @default(cuid())
  name                    String
  phone                   String?
  whatsapp                String?
  email                   String?
  company                 String?
  status                  CustomerStatus               @default(NEW)
  country                 String?
  customerNotes           String?                      @map("notes")
  customerType            CustomerType?
  segment                 CustomerSegment? // Phase 98 — B2B / Installation / Marketplace çatısı
  industryId              String?          // Phase 99 — alt sektör (Industry.id)
  industry                Industry?        @relation(fields: [industryId], references: [id], onDelete: SetNull)
  usedTech                String[]         @default([]) // IP, AHD, PoE, NVR, Alarm, vb.
  currentSupplier         String?          // Şu an aldığı marka/firma — rakip bilgisi
  monthlySalesPotential   Decimal?
  platformNotes           String?
  city                    String?
  district                String?
  address                 String?
  taxOffice               String?
  taxNumber               String?
  source                  String?
  ownedById               String?
  isActive                Boolean                      @default(true)
  lastContactedAt         DateTime?
  // Phase 95b — Çağrı Merkezi Sales Workspace v2
  tags                    String[]                     @default([]) // VIP, Bayi, Anahtar, vb.
  doNotCall               Boolean                      @default(false) // DND — bir daha aramayın
  avatarUrl               String? // foto / logo
  callAttempts            Int                          @default(0) // açılmadı sayacı (3+ olunca auto-snooze)
  lastCallAttemptAt       DateTime?
  shownInQueueCount       Int                          @default(0) // anti-monotony rotation
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  owner                   User?                        @relation("OwnedCustomers", fields: [ownedById], references: [id], onDelete: SetNull)
  interests               ProductInterest[]
  categoryInterests       CategoryInterest[]
  timelineEntries         Note[]
  tasks                   FollowUpTask[]
  quotes                  Quote[]
  outreachRecipients      OutreachRecipient[]
  attributeInterests      CustomerAttributeInterest[]
  marketplaceSalesRecords MarketplaceSalesRecord[]     @relation("MarketplaceSalesCustomer")
  leadListMemberships     CustomerLeadListMembership[] @relation("CustomerLeadLists")
  catalogShares           CatalogShare[] // Faz 4 — gönderilen katalog linkleri

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([ownedById])
  @@index([source])
  @@index([taxNumber])
  @@index([doNotCall])
  @@index([shownInQueueCount])
  @@index([segment])
  @@index([industryId])
  @@index([city])
  @@index([district])
}

// Phase 97 — Lead List Manager (Google Maps Import)
model LeadList {
  id          String                       @id @default(cuid())
  name        String // "Hatay güvenlik şirketleri Mayıs 2026"
  source      String // "Google Maps" | "Manuel" | "Trendyol Q&A"
  city        String? // "Hatay"
  category    String? // "Güvenlik"
  totalCount  Int                          @default(0)
  importedAt  DateTime                     @default(now())
  createdById String
  createdBy   User                         @relation("UserLeadLists", fields: [createdById], references: [id], onDelete: Cascade)
  members     CustomerLeadListMembership[]

  @@index([createdById])
  @@index([source])
  @@index([city])
}

model CustomerLeadListMembership {
  customerId String
  leadListId String
  addedAt    DateTime @default(now())
  customer   Customer @relation("CustomerLeadLists", fields: [customerId], references: [id], onDelete: Cascade)
  leadList   LeadList @relation(fields: [leadListId], references: [id], onDelete: Cascade)

  @@id([customerId, leadListId])
  @@index([leadListId])
}

// Phase 96d — WhatsApp / mesaj şablonları
model MessageTemplate {
  id          String   @id @default(cuid())
  name        String // "İlk Teklif Sonrası Hatırlatma"
  channel     String   @default("whatsapp") // whatsapp | sms | email
  category    String? // "follow-up" | "negotiation" | "after-sale"
  body        String   @db.Text // Değişkenler: {{musteri_adi}}, {{teklif_no}}, {{son_gorusme}}, {{firma}}
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("CreatedMessageTemplates", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([channel])
  @@index([createdById])
}

// Phase 95f — Kayıtlı görünümler (saved views)
model SavedView {
  id          String   @id @default(cuid())
  userId      String // owner (user-private veya shared)
  name        String // "Mersin'deki ticarilerim"
  isShared    Boolean  @default(false)
  resource    String // "customers" | "products" | "marketplace" — gelecek için generic
  filtersJson String // URL params snapshot
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("UserSavedViews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, resource])
  @@index([isShared, resource])
}

model CategoryInterest {
  id          String          @id @default(cuid())
  customerId  String
  categoryId  String
  stage       InterestStage   @default(INTERESTED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("CreatedCategoryInterests", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([customerId, categoryId])
  @@index([customerId])
  @@index([categoryId])
}

model ProductInterest {
  id              String           @id @default(cuid())
  customerId      String
  productId       String
  quantity        Int              @default(1) @map("quantityRequested")
  quotedPrice     Decimal?
  currency        String           @default("TRY")
  stage           InterestStage    @default(INTERESTED)
  interestNotes   String?          @map("note")
  targetPrice     Decimal?
  priority        InterestPriority @default(NORMAL)
  status          InterestStatus   @default(NEW)
  followUpAt      DateTime?
  lastContactedAt DateTime?
  closedAt        DateTime?
  source          String?
  createdById     String?
  assignedToId    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("CreatedInterests", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo      User?            @relation("AssignedInterests", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           Note[]

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([priority])
  @@index([followUpAt])
  @@index([stage])
}

model Note {
  id          String           @id @default(cuid())
  content     String
  type        NoteType         @default(NOTE)
  customerId  String?
  productId   String?
  interestId  String?
  createdById String?
  createdAt   DateTime         @default(now())
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  interest    ProductInterest? @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([productId])
  @@index([interestId])
  @@index([createdAt])
}

model FollowUpTask {
  id           String       @id @default(cuid())
  title        String
  description  String?      @map("details")
  dueDate      DateTime?    @map("dueAt")
  status       TaskStatus   @default(OPEN)
  priority     TaskPriority @default(MEDIUM)
  completedAt  DateTime?
  customerId   String?
  productId    String?
  assignedToId String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dueDate])
  @@index([priority])
}

model Quote {
  id                 String              @id @default(cuid())
  customerId         String
  quoteNumber        String              @unique
  status             QuoteStatus         @default(DRAFT)
  notes              String?
  paymentTerms       String?
  deliveryTerms      String?
  warrantyTerms      String?
  validityDate       DateTime?
  sentAt             DateTime?
  currencyMode       QuoteCurrencyMode   @default(TRY)
  exchangeRate       Decimal?
  subtotal           Decimal             @default(0)
  discountTotal      Decimal             @default(0)
  taxTotal           Decimal             @default(0)
  total              Decimal             @default(0)
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items              QuoteItem[]
  outreachRecipients OutreachRecipient[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([validityDate])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal
  currency    String   @default("TRY")
  discount    Decimal  @default(0)
  tax         Decimal  @default(0)
  total       Decimal  @default(0)
  createdAt   DateTime @default(now())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
}

// Phase 18 — Quote Templates
model QuoteTemplate {
  id            String              @id @default(cuid())
  name          String
  description   String?
  paymentTerms  String?
  deliveryTerms String?
  warrantyTerms String?
  notes         String?
  currencyMode  QuoteCurrencyMode   @default(TRY)
  isActive      Boolean             @default(true)
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdBy     User?               @relation("TemplatesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  items         QuoteTemplateItem[]

  @@index([isActive])
  @@index([createdAt])
}

model QuoteTemplateItem {
  id          String        @id @default(cuid())
  templateId  String
  productId   String?
  description String
  quantity    Int           @default(1)
  unitPrice   Decimal
  currency    String        @default("TRY")
  discount    Decimal       @default(0)
  tax         Decimal       @default(20)
  sortOrder   Int           @default(0)
  template    QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product     Product?      @relation("TemplateItems", fields: [productId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([productId])
}

model OutreachCampaign {
  id          String              @id @default(cuid())
  productId   String?
  categoryId  String?
  message     String
  offerText   String?
  price       Decimal?
  currency    String              @default("TRY")
  status      OutreachStatus      @default(DRAFT)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  category    ProductCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("CreatedCampaigns", fields: [createdById], references: [id], onDelete: SetNull)
  recipients  OutreachRecipient[]

  @@index([productId])
  @@index([categoryId])
  @@index([createdAt])
}

// Phase 11 — XML Inventory Sync
model XmlSyncSource {
  id           String       @id @default(cuid())
  name         String
  url          String
  secondaryUrl String? // Phase 75: optional supplementary feed (same supplier, different subset)
  isEnabled    Boolean      @default(true)
  authHeader   String?
  lastSyncAt   DateTime?
  lastStatus   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  logs         XmlSyncLog[]
}

model XmlSyncLog {
  id             String        @id @default(cuid())
  sourceId       String
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  status         XmlSyncStatus @default(RUNNING)
  recordsFound   Int           @default(0)
  recordsCreated Int           @default(0) // Phase 11A: new products created from XML
  recordsUpdated Int           @default(0)
  recordsSkipped Int           @default(0)
  errorMessage   String?
  source         XmlSyncSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([startedAt])
}

// Phase 10 — Capital Allocation Engine (admin-only)
model CapitalConfig {
  id                    String   @id @default(cuid())
  totalCapitalTry       Decimal
  reservePct            Decimal  @default(20)
  desiredTurnoverMonths Decimal  @default(3)
  updatedAt             DateTime @updatedAt
  updatedById           String?
  updatedBy             User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// Phase 12 — Marketplace Listing Registry
model MarketplaceListing {
  id                String              @id @default(cuid())
  productId         String
  platform          MarketplacePlatform
  platformListingId String?
  listingUrl        String?
  listingBarcode    String?
  listingSku        String?
  listingTitle      String?
  status            ListingStatus       @default(UNKNOWN)
  lastCheckedAt     DateTime?
  notes             String?
  responsibleId     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  responsible       User?               @relation("ListingResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([platform])
  @@index([status])
  @@index([responsibleId])
}

// Phase 16 — Marketplace Product Mapping Engine
// Maps one or more marketplace identities to a single internal product.
// Multiple rows can point to the same productId (many-to-one design).
// Uniqueness enforced per (platform, platformBarcode) to prevent split-brain mappings.
model MarketplaceProductMapping {
  id                String              @id @default(cuid())
  platform          MarketplacePlatform
  platformProductId String?
  platformListingId String?
  platformBarcode   String?
  platformSku       String?
  platformTitle     String?
  productId         String
  confidence        String              @default("MANUAL") // MANUAL | BARCODE | SKU | LISTING
  isManual          Boolean             @default(true)
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy         User?               @relation("MappingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([platform])
  @@index([productId])
  @@index([platform, platformBarcode])
  @@index([platform, platformSku])
  @@index([platform, platformListingId])
}

// Phase 16 — Audit log for customer question actions (answer sent to Trendyol)
model MarketplaceQuestionActionLog {
  id             String   @id @default(cuid())
  platform       String   @default("TRENDYOL")
  questionId     String
  actionType     String   @default("ANSWERED")
  answerText     String?
  userId         String?
  responseStatus String // SUCCESS | ERROR
  errorMessage   String?
  createdAt      DateTime @default(now())
  user           User?    @relation("QuestionActionUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([platform])
  @@index([userId])
  @@index([createdAt])
}

// Phase 16 — Audit log for return claim actions (approve / issue created)
model MarketplaceReturnActionLog {
  id             String   @id @default(cuid())
  platform       String   @default("TRENDYOL")
  claimId        String
  claimItemId    String?
  actionType     String // APPROVED | ISSUE_CREATED
  reasonCode     String?
  note           String?
  userId         String?
  responseStatus String // SUCCESS | ERROR
  errorMessage   String?
  createdAt      DateTime @default(now())
  user           User?    @relation("ReturnActionUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([claimId])
  @@index([platform])
  @@index([userId])
  @@index([createdAt])
}

// Phase 16 — Historical monthly USD/TRY exchange rates for profit calculation
// Phase 31 — Added rmbUsdRate for RMB-first import formula
model MonthlyExchangeRate {
  id         String   @id @default(cuid())
  year       Int
  month      Int // 1–12
  usdTryRate Decimal
  rmbUsdRate Decimal? @db.Decimal(12, 4) // RMB per 1 USD (e.g. 7.25)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([year, month])
  @@index([year, month])
}

// Phase 14 — Trendyol API Integration (singleton config row)
model TrendyolConfig {
  id         String    @id @default("singleton")
  supplierId String    @default("")
  apiKey     String    @default("")
  apiSecret  String    @default("")
  isEnabled  Boolean   @default(false)
  lastSyncAt DateTime?
  updatedAt  DateTime  @updatedAt
}

// Hepsiburada Marketplace API config (singleton row, paralel mimari Trendyol'a)
// READ-ONLY: katalog/sipariş/iade çekiyoruz; push işlemi Entegra'nın işi.
model HepsiburadaConfig {
  id         String    @id @default("singleton")
  merchantId String    @default("")
  username   String    @default("")
  password   String    @default("")
  storeName  String? // bilgi amaçlı (mağaza adı)
  isEnabled  Boolean   @default(false)
  lastSyncAt DateTime?
  updatedAt  DateTime  @updatedAt
}

model OutreachRecipient {
  id         String           @id @default(cuid())
  campaignId String
  customerId String
  phone      String?
  status     RecipientStatus  @default(PENDING)
  sentAt     DateTime?
  repliedAt  DateTime?
  quoteId    String?
  wonAmount  Decimal?
  createdAt  DateTime         @default(now())
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quote      Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@unique([campaignId, customerId])
  @@index([campaignId])
  @@index([customerId])
  @@index([quoteId])
}

// Phase 11A — Product multi-image support
// sortOrder 0 = primary image (maps to resim1), 1-4 = resim2-5
model ProductImage {
  id        String                      @id @default(cuid())
  productId String
  url       String
  sortOrder Int                         @default(0) // 0=primary
  source    String                      @default("XML") // XML | MANUAL
  altText   String?
  // Phase 91 — CLIP image embedding (512-dim) for similarity search.
  // Populated by scripts/backfill-image-embeddings.ts via Hugging Face Inference.
  embedding Unsupported("vector(512)")?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  product   Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId])
}

// Phase 11A — XML source data snapshot per product (one row per product)
// Stores raw XML feed values without polluting the Product master record.
// These are informational; IOTOMASYON product fields are the business truth.
model XmlProductData {
  id                    String   @id @default(cuid())
  productId             String   @unique // one row per product
  sourceId              String? // which XmlSyncSource produced this
  xmlSku                String // urun_kodu
  xmlName               String? // urun_ismi
  xmlBrand              String? // marka
  xmlUrunTipi           String? // urun_tipi (informational, not business truth)
  xmlCurrencyType       String? // CurrencyType (USD/TRY)
  xmlKdv                Decimal? // KDV rate
  xmlDateChange         String? // date_change raw string
  xmlDateAdd            String? // date_add raw string
  xmlAnaUrunKodu        String? // ana_urun_kodu (parent product code)
  // USD-denominated marketplace prices from XML
  xmlPrice4             Decimal? // base price (price4)
  xmlTrendyolPrice      Decimal? // trendyol_salePrice
  xmlHbPrice            Decimal? // hb_price
  xmlAmazonPrice        Decimal? // amazon_price
  xmlPazaramaPrice      Decimal? // pazarama_salePrice
  xmlIdefixPrice        Decimal? // idefix_sale_price
  xmlBayiPrice          Decimal? // bayi (dealer)
  xmlKoctasPrice        Decimal? // koctas
  xmlTeknosaPrice       Decimal? // teknosa_sale_price
  xmlTemuPrice          Decimal? // temu_sale_price
  // Textual content
  xmlDescription        String? // aciklama
  // Image URLs (preserved for reference even if ProductImage table is used)
  xmlImage1             String?
  xmlImage2             String?
  xmlImage3             String?
  xmlImage4             String?
  xmlImage5             String?
  // Sync tracking
  firstSeenAt           DateTime @default(now())
  lastSeenAt            DateTime @default(now())
  missingFromLatestFeed Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([xmlSku])
  @@index([lastSeenAt])
  @@index([missingFromLatestFeed])
}

// ─── Phase 20 — Supplier Intelligence ────────────────────────────────────────

model Supplier {
  id                        String   @id @default(cuid())
  name                      String
  contactName               String?
  phone                     String?
  email                     String?
  countryOfOrigin           String? // e.g. "CN", "TR", "DE"
  paymentTerms              String? // free text: "NET 30", "Peşin", etc.
  defaultLeadDays           Int? // default lead time in days for this supplier
  notes                     String?
  isActive                  Boolean  @default(true)
  // Phase 32 — Supplier-level import defaults
  defaultAirFreightUsdPerKg Decimal? @db.Decimal(8, 4) // override AIR freight rate for this supplier
  defaultSeaFreightUsdPerKg Decimal? @db.Decimal(8, 4) // override SEA freight rate for this supplier
  defaultPaymentFeePct      Decimal? @db.Decimal(5, 2) // override payment commission % for this supplier
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  products          SupplierProduct[]
  decisionSnapshots ImportDecisionSnapshot[]
  purchaseOrders    PurchaseOrder[] // Phase 77

  @@index([name])
  @@index([isActive])
}

// One row per (supplier, product) pair.
// leadDays / unitCostUsd override the supplier-level defaults for this specific product.
model SupplierProduct {
  id          String   @id @default(cuid())
  supplierId  String
  productId   String
  unitCostUsd Decimal? // supplier price for this product in USD
  moq         Int? // minimum order quantity
  leadDays    Int? // lead time override for this product (days)
  isPreferred Boolean  @default(false) // preferred supplier for this product
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
  @@index([isPreferred])
}

// ─── Phase 26 — Product Performance Ranking ───────────────────────────────────
// One row per Trendyol order line. Synced via /admin/product-performance.
// productId is nullable: unmatched lines kept for audit but excluded from rankings.

// Singleton model — şirket bilgileri ve default ticari koşullar.
// PDF generator'lar (catalog + quote), login sayfası ve müşteri-facing footer'lar
// bu tabloya bakar. İlk yaratımda `lib/company-settings.ts`'teki defaults seed olur.
// Tek satır beklenir (id = "default"). UI: /admin/company-settings
model CompanySettings {
  id                 String   @id @default("default")
  // Marka
  companyName        String
  legalName          String
  tagline            String
  salesContact       String
  // İletişim
  website            String
  email              String
  phone              String
  phoneSecondary     String
  // Adresler
  address            String   @db.Text
  perpaAddress       String   @db.Text
  city               String
  district           String
  country            String
  // Vergi
  taxOffice          String
  taxNumber          String
  // Banka
  bankName           String
  bankIban           String
  bankAccountHolder  String
  bankAccountType    String
  // Default ticari koşullar (PDF'te bunlar fallback; quote başına override mümkün)
  paymentTerms       String   @db.Text
  deliveryTerms      String   @db.Text
  warrantyTerms      String   @db.Text
  updatedAt          DateTime @updatedAt
}

// Catalog profilleri — Industry.slug ile join edilir, müşteriye gönderilecek
// katalogun kategori seti, başlık, altyazı ve fiyat modunu belirler.
// /admin/catalog-profiles sayfasından düzenlenir.
//
// Mevcut hard-coded mapping (lib/catalog-mapping.ts) bu tabloya seed olur.
// getCatalogProfile() async olarak DB'den okur, DB miss durumunda hard-coded
// fallback (lib/catalog-mapping-fallback.ts) devreye girer.
model CatalogProfile {
  id               String   @id @default(cuid())
  slug             String   @unique  // Industry.slug ile eşleşir, "general" özel fallback
  title            String   // PDF kapak başlığı
  subtitle         String   // PDF kapak alt başlığı
  categorySlugs    String[] // ProductCategory.slug listesi (Postgres text[])
  defaultPriceMode String   // "wholesale" | "retail" | "hidden"
  enabled          Boolean  @default(true)
  sortOrder        Int      @default(100)
  updatedAt        DateTime @updatedAt

  @@index([enabled])
}

model ProductSourceLink {
  id         String   @id @default(cuid())
  productId  String
  sourceName String   @default("1688")
  label      String?
  url        String
  notes      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sourceName])
  @@index([sortOrder])
}

model TrendyolSalesRecord {
  id        String   @id @default(cuid())
  orderId   String // Trendyol order numeric ID (as string)
  lineId    BigInt // order line ID — Trendyol uses int64, exceeds PostgreSQL INT range
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  orderDate     DateTime
  status        String // e.g. "Delivered", "Cancelled", "Picking"
  merchantSku   String?
  barcode       String?
  productName   String
  quantity      Int
  unitPriceTry  Decimal  @db.Decimal(15, 2) // discountedPrice per unit
  totalPriceTry Decimal  @db.Decimal(15, 2) // quantity × discountedPrice
  syncedAt      DateTime @default(now())
  stockDeducted Boolean  @default(false) // Phase 43: true once quantity deducted from Product.stockQuantity

  @@unique([orderId, lineId])
  @@index([productId])
  @@index([orderDate])
  @@index([merchantSku])
  @@index([barcode])
}

// ─── Phase 29 — Order Ledger and Return Claims ────────────────────────────────
// One row per Trendyol claim × order-line pair.
// claimId+orderLineId is the natural unique key from the Trendyol claims API.
// productId is nullable: unmatched claims kept for audit.

model TrendyolReturnRecord {
  id          String   @id @default(cuid())
  claimId     String // Trendyol claim ID (string)
  orderLineId Int // Trendyol order line ID within the claim
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  orderNumber String // Trendyol order number (display string)
  orderDate   DateTime // original order date
  claimDate   DateTime // when the return claim was opened
  status      String // claimItemStatus.name e.g. "Accepted", "WaitingForArrival"
  reasonName  String? // Turkish reason from customerClaimItemReason.name
  reasonCode  String? // reason code

  productName  String
  barcode      String?
  merchantSku  String?
  unitPriceTry Decimal  @default(0) @db.Decimal(15, 2)
  syncedAt     DateTime @default(now())

  @@unique([claimId, orderLineId])
  @@index([productId])
  @@index([claimDate])
  @@index([orderNumber])
  @@index([status])
}

// ─── Hepsiburada — Trendyol paralel modelleri (READ-ONLY) ───────────────────
// productId nullable: eşleşmemiş kayıtlar audit için tutulur.

model HepsiburadaSalesRecord {
  id        String   @id @default(cuid())
  orderId   String // Hepsiburada order number (display)
  lineId    String // Hepsiburada line item ID
  productId String?
  product   Product? @relation("HbSalesProduct", fields: [productId], references: [id], onDelete: SetNull)

  orderDate     DateTime
  status        String // e.g. "Delivered", "Cancelled"
  merchantSku   String?
  barcode       String?
  hbSku         String? // Hepsiburada SKU (HBSKU)
  productName   String
  quantity      Int
  unitPriceTry  Decimal  @db.Decimal(15, 2)
  totalPriceTry Decimal  @db.Decimal(15, 2)
  syncedAt      DateTime @default(now())

  @@unique([orderId, lineId])
  @@index([productId])
  @@index([orderDate])
  @@index([merchantSku])
  @@index([barcode])
}

model HepsiburadaReturnRecord {
  id          String   @id @default(cuid())
  claimId     String
  orderLineId String
  productId   String?
  product     Product? @relation("HbReturnsProduct", fields: [productId], references: [id], onDelete: SetNull)

  orderNumber String
  orderDate   DateTime
  claimDate   DateTime
  status      String
  reasonName  String?
  reasonCode  String?

  productName  String
  barcode      String?
  merchantSku  String?
  unitPriceTry Decimal  @default(0) @db.Decimal(15, 2)
  syncedAt     DateTime @default(now())

  @@unique([claimId, orderLineId])
  @@index([productId])
  @@index([claimDate])
  @@index([orderNumber])
  @@index([status])
}

// ─── Phase 92 — Generic Marketplace Sales Record ───────────────────────────────
// Tüm pazaryeri kanalları için tek tablo (channel discriminator). Entegra
// ihracı + diğer kanallar (N11, Ideasoft, GG, Pazarama, EPTT, mirakl_koctas,
// idefix, Amazon, ciceksepeti, Temu, mirakl_teknosa, Shopphp, Manual) burada.
// Trendyol API'sinden gelen kayıtlar TrendyolSalesRecord'da kalır; Excel'den
// yüklenirken existing Trendyol orderId'leri atlanır (no double count).

model MarketplaceSalesRecord {
  id             String  @id @default(cuid())
  channel        String // TRENDYOL | HEPSIBURADA | N11 | IDEASOFT | GG | PAZARAMA | EPTT | MIRAKL_KOCTAS | IDEFIX | AMAZON | CICEKSEPETI | TEMU | MIRAKL_TEKNOSA | SHOPPHP | MANUAL
  orderNumber    String // "Sipariş Numarası" (composite veya tek)
  platformRef    String? // "Platform Ref. No"
  externalLineId String? // Entegra ID kolonu (line-item identifier)

  orderDate DateTime
  status    String? // "Durum Adı" — Yeni Siparis / Onaylandı / İade-İptal vb.

  productName    String?
  productCode    String?
  modelNumber    String?
  storeStockName String?
  productId      String?
  product        Product? @relation("MarketplaceSalesProduct", fields: [productId], references: [id], onDelete: SetNull)

  quantity           Int      @default(1)
  grossAmountTry     Decimal? @db.Decimal(15, 2) // "Toplam"
  vatAmountTry       Decimal? @db.Decimal(15, 2) // "Vergi"
  totalAmountTry     Decimal? @db.Decimal(15, 2) // "Genel Toplam"
  commissionTry      Decimal? @db.Decimal(15, 2) // "Komisyon Tutarı"
  commissionPct      Decimal? @db.Decimal(5, 2) // "Komisyon Oranı"
  platformPaymentTry Decimal? @db.Decimal(15, 2) // "PazaryerindenGelenOdemeTutar"

  customerCode         String? // "Müşteri Kodu"
  customerFirma        String? // "Firma"
  customerInvoiceName  String? // "Fatura Adı"
  customerVergiNo      String? // "Vergi No"
  customerTcKimlik     String? // "TC Kimlik"
  customerVergiDairesi String? // "Vergi Dairesi"
  customerCity         String? // "Fatura Şehir"

  cargoCompany    String?
  cargoTrackingNo String?
  desiTotal       Decimal? @db.Decimal(8, 2)

  customerId String?
  customer   Customer? @relation("MarketplaceSalesCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  importedAt DateTime @default(now())

  @@unique([channel, orderNumber, externalLineId])
  @@index([channel])
  @@index([orderDate])
  @@index([productId])
  @@index([customerId])
  @@index([customerVergiNo])
  @@index([customerCity])
  @@index([status])
  // Composite index — pazaryeri performans/kâr sayfalarındaki "kanal × tarih" sorguları
  // (142k satırlık tablo, query başına 100-500ms → 10-50ms hedef).
  @@index([channel, orderDate])
  // productId + orderDate composite — ürün başına satış geçmişi sayfasında
  @@index([productId, orderDate])
}

// Phase 30 — Marketplace Margin Policy Normalization
// Stores per-platform standard shipping cost and commission rate.
// Resolution order (highest priority first):
//   1. product.shippingCostOverride  / product.marketplaceCommissionOverride
//   2. product.shippingCost          / product.marketplaceCommission  (product-level)
//   3. MarketplacePlatformPolicy     (platform-level standard)
//   4. system default (shipping=0, commission=20%)

model MarketplacePlatformPolicy {
  id                    String              @id @default(cuid())
  platform              MarketplacePlatform @unique
  standardShippingTry   Decimal             @default(0) @db.Decimal(10, 2)
  standardCommissionPct Decimal             @default(20) @db.Decimal(5, 2)
  paymentFeePct         Decimal             @default(0) @db.Decimal(5, 2)
  returnReservePct      Decimal             @default(0) @db.Decimal(5, 2)
  vatPct                Decimal             @default(20) @db.Decimal(5, 2)
  // Phase 51 — USD-tiered shipping: JSON array [{maxPriceUsd?, costUsd}]
  // Last entry (no maxPriceUsd) is the catch-all fallback.
  // If null, falls back to standardShippingTry.
  shippingTiersJson     String?
  notes                 String?
  updatedAt             DateTime            @updatedAt
  updatedById           String?
  updatedBy             User?               @relation("PolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([platform])
}

// ─── Phase 32 — Holding-Grade Import Governance ───────────────────────────────
// Snapshots freeze the full set of import decision inputs + computed outputs
// at the moment an operator approves a buy decision.
// After rates or defaults change, historical decisions remain explainable.

model ImportDecisionSnapshot {
  id                  String    @id @default(cuid())
  productId           String
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // Rate context
  rateYear            Int?
  rateMonth           Int?
  usdTryRate          Decimal   @db.Decimal(12, 4)
  rmbUsdRate          Decimal?  @db.Decimal(12, 4)
  // Frozen inputs
  sourceCostRmb       Decimal?  @db.Decimal(15, 2)
  sourcePriceUsd      Decimal?  @db.Decimal(12, 4)
  importPaymentFeePct Decimal?  @db.Decimal(5, 2)
  weightKg            Decimal?  @db.Decimal(8, 3)
  customsRatePct      Decimal?  @db.Decimal(5, 2)
  shippingMethodPref  String?
  airFreightPerKg     Decimal   @db.Decimal(8, 4)
  seaFreightPerKg     Decimal   @db.Decimal(8, 4)
  // Computed outputs
  effectiveSourceUsd  Decimal   @db.Decimal(12, 4) // resolved USD cost (after RMB conversion + payment fee)
  effectiveMethod     String // AIR or SEA
  landedCostUsd       Decimal   @db.Decimal(12, 4)
  profitRatio         Decimal   @db.Decimal(8, 4)
  decision            String // ALWAYS_STOCK / BUY_SMALL / DO_NOT_BUY / MISSING_DATA
  score               Decimal   @db.Decimal(8, 4)
  notes               String?
  createdById         String?
  createdBy           User?     @relation("SnapshotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())

  @@index([productId])
  @@index([supplierId])
  @@index([createdAt])
}

// ─── Phase 42 — Stock Adjustment Log ─────────────────────────────────────────
// Records every manual stock movement for audit and traceability.
// quantityChange: positive = stock increase, negative = decrease.
// previousQty and newQty are frozen at write time so history stays correct
// even if the product stockQuantity is later corrected again.

model StockAdjustmentLog {
  id             String              @id @default(cuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustmentType StockAdjustmentType
  quantityChange Int // positive = in, negative = out
  previousQty    Int
  newQty         Int
  notes          String?
  createdById    String?
  createdBy      User?               @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([adjustmentType])
}

// ─── Phase 49 — XML Stok Değişim Logu ────────────────────────────────────────
// Records every stock quantity change made by XML sync (Entegra ERP).
// Allows operators to audit which products' stock changed in each sync run.
// delta = newQty - previousQty (positive = restock/increase, negative = depletion)

model XmlStockChangeLog {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  syncLogId   String
  sourceId    String
  previousQty Int
  newQty      Int
  delta       Int
  syncedAt    DateTime @default(now())

  @@index([productId])
  @@index([syncLogId])
  @@index([sourceId])
  @@index([syncedAt])
}

// ─── Phase 77 — Satın Alma Siparişi (Purchase Order) ────────────────────────
// Tracks import purchase orders created by the admin.
// Orders can be pre-filled from capital allocation suggestions or import
// decision recommendations. Status flows: DRAFT → CONFIRMED → ORDERED → RECEIVED.

enum PurchaseOrderStatus {
  DRAFT // being built; not yet sent to supplier
  CONFIRMED // reviewed and approved internally
  ORDERED // sent to supplier / payment made
  SHIPPED // in transit
  RECEIVED // stock arrived and counted
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  orderNo          String              @unique // auto: PO-YYYYMMDD-NNN
  supplierId       String?
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status           PurchaseOrderStatus @default(DRAFT)
  shippingMethod   String? // AIR | SEA
  orderDate        DateTime            @default(now())
  estimatedArrival DateTime?
  notes            String?
  totalCostTry     Decimal?            @db.Decimal(14, 2) // estimated total landed cost
  createdById      String?
  createdBy        User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id           String        @id @default(cuid())
  orderId      String
  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  qty          Int // ordered quantity
  unitCostRmb  Decimal?      @db.Decimal(12, 4) // snapshot of sourceCostRmb at order time
  unitCostTry  Decimal?      @db.Decimal(12, 2) // estimated landed cost per unit in TRY
  totalCostTry Decimal?      @db.Decimal(14, 2) // qty × unitCostTry
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
}

// Faz 4 — Public katalog link + view analytics
// Sales rep "Katalog Gönder" yaptığında oluşturulur. Müşteri /c/[token] üzerinden
// (login gerektirmeden) açar. Açılma + ürün ilgi olayları takip edilir.
model CatalogShare {
  id                  String                  @id @default(cuid())
  token               String                  @unique // /c/{token} public route
  customerId          String
  sentById            String?
  profileSlug         String                  // CatalogProfile.slug
  priceMode           String                  // "wholesale" | "retail" | "hidden"
  brandFilter         String?                 // CSV — modal'da seçilen markalar
  onlyStock           Boolean                 @default(true)
  coverNote           String?                 @db.Text
  expiresAt           DateTime                // 30 gün varsayılan
  viewCount           Int                     @default(0)
  firstViewedAt       DateTime?
  lastViewedAt        DateTime?
  followUpTaskCreated Boolean                 @default(false) // 24h sonra task spawn flag
  createdAt           DateTime                @default(now())
  customer            Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sentBy              User?                   @relation("CatalogSharesSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  productInterests    CatalogProductInterest[]

  @@index([token])
  @@index([customerId])
  @@index([sentById])
  @@index([createdAt])
}

// Müşteri katalog içinde bir ürüne "İlgilendim" tıklarsa kayıt olur.
// Otomatik olarak ana ProductInterest tablosuna da düşer (catalog-share-service'te).
model CatalogProductInterest {
  id             String       @id @default(cuid())
  catalogShareId String
  productId      String
  action         String       // "INTERESTED" | "ADD_TO_CART" | "VIEWED_LONG"
  createdAt      DateTime     @default(now())
  share          CatalogShare @relation(fields: [catalogShareId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([catalogShareId])
  @@index([productId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PDKS (Personel Devam Kontrol Sistemi) — Faz 1
// Multi-tenant devam takip modülü. Tenant izolasyonu UYGULAMA katmanındadır
// (lib/pdks: AsyncLocalStorage + Prisma client extension); DB-seviyesi RLS yok.
// Tablolar public şemada, "pdks_" önekli (ayrı Postgres şeması yerine — mevcut
// modellere @@schema eklememek için). Model adları "Pdks" önekli.
// ═══════════════════════════════════════════════════════════════════════════

model PdksTenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  // Haftalık çalışma programı (JSON: 7 elemanlı dizi, 0=Pazar..6=Cmt; null=tatil,
  // dolu={in,out}). null kolon = kod-içi varsayılan program kullanılır.
  workScheduleJson String?
  // Resmi tatiller (JSON: [{date:"YYYY-MM-DD", name}]). Bu günlerde hatırlatma/
  // otomatik çıkış yapılmaz ve rapor beklenen iş gününden düşülür.
  holidaysJson String?

  // ── Abonelik / SaaS (Faz 2) ──────────────────────────────────────────────
  // Self-servis kayıt + aylık/yıllık abonelik. Erişim kapısı bu alanlara bakar.
  subscriptionStatus String    @default("trial") // trial | active | past_due | canceled
  plan               String? // 'monthly' | 'yearly' | null (deneme)
  trialEndsAt        DateTime? // deneme bitişi (UTC); kayıt anında +30 gün
  currentPeriodEnd   DateTime? // ödenmiş dönemin bitişi (UTC)
  ownerEmail         String? // kaydı yapan müşteri e-postası (bildirim/fatura)

  createdAt DateTime @default(now())

  personnel PdksPersonnel[]
  worksites PdksWorksite[]
  records   PdksAttendanceRecord[]
  subs      PdksPushSubscription[]
  leaves    PdksLeave[]

  @@map("pdks_tenants")
}

model PdksLeave {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      PdksTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personnelId String
  personnel   PdksPersonnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date // dahil
  type        String        @default("annual") // annual | sick | unpaid | other
  reason      String?
  status      String        @default("pending") // pending | approved | rejected
  requestedBy String        @default("personnel") // 'personnel' | 'admin'
  decidedBy   String? // karar veren CRM kullanıcı id
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([tenantId])
  @@index([personnelId])
  @@map("pdks_leaves")
}

model PdksPersonnel {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          PdksTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // CRM kullanıcısıyla opsiyonel bağ (yalnızca CRM'e de giren adminler); saha
  // çalışanları CRM User'ı olmak zorunda değil — OTP ile kimliklenir.
  crmUserId       String?
  fullName        String
  phone           String?
  email           String?
  role            String     @default("employee") // 'tenant_admin' | 'employee'
  // Kalıcı giriş şifresi/PIN (bcrypt). null = henüz şifre atanmamış → giriş yapamaz.
  passwordHash    String?
  // Cihaz bağlama: ilk girişte üretilen cihaz token'ının SHA-256 hash'i. null =
  // henüz cihaza bağlı değil (ilk giriş bağlar). Admin "cihazı sıfırla" ile null'lar.
  deviceIdHash    String?
  deviceBoundAt   DateTime?
  expectedCheckIn String? // "08:30" — hatırlatma eşiği
  expectedCheckOut String? // "18:00" — beklenen çıkış saati
  // Geç-kalan hatırlatması en son hangi TR gününde gönderildi (cron idempotency).
  lastLateReminderOn DateTime? @db.Date
  // O gün gönderilen son "geç kalma" eşiği (dakika); aynı 5-dk dilimini tekrar göndermez.
  lateReminderLastMin Int      @default(0)
  // KVKK açık rıza zamanı (konum işleme). null = rıza yok → giriş/çıkış engellenir.
  kvkkConsentAt   DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())

  worksites  PdksPersonnelWorksite[]
  records    PdksAttendanceRecord[]
  subs       PdksPushSubscription[]
  loginCodes PdksLoginCode[]
  leaves     PdksLeave[]

  @@index([tenantId])
  @@map("pdks_personnel")
}

model PdksWorksite {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       PdksTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int        @default(100)
  // Kabul edilen azami konum doğruluğu (GPS accuracy, metre). Cihazın bildirdiği
  // accuracy bunu aşarsa check-in reddedilir. Şehir içi/yoğun yapı sahalarında
  // GPS zayıf olabileceğinden şantiye-başına ayarlanabilir (spec §7).
  maxAccuracyMeters Int    @default(100)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  personnel PdksPersonnelWorksite[]
  records   PdksAttendanceRecord[]

  @@index([tenantId])
  @@map("pdks_worksites")
}

model PdksPersonnelWorksite {
  tenantId    String
  personnelId String
  worksiteId  String
  personnel   PdksPersonnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  worksite    PdksWorksite  @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@id([personnelId, worksiteId])
  @@index([tenantId])
  @@map("pdks_personnel_worksites")
}

model PdksAttendanceRecord {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            PdksTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personnelId       String
  personnel         PdksPersonnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  worksiteId        String?
  worksite          PdksWorksite? @relation(fields: [worksiteId], references: [id])
  workDate          DateTime      @db.Date
  checkInAt         DateTime?
  checkOutAt        DateTime?
  checkInDistanceM  Int? // mesafe HER ZAMAN saklanır
  checkOutDistanceM Int?
  checkInAccuracyM  Int?
  checkOutAccuracyM Int?
  checkInLat        Float? // OPSİYONEL (KVKK) — varsayılan kapalı
  checkInLng        Float?
  status            String        @default("open") // 'open' | 'closed'
  // Otomatik çıkış: personel beklenen çıkıştan +15 dk sonra çıkış yapmamışsa
  // sistem kaydı kapatır (checkOutAt = beklenen çıkış saati). true = elle değil.
  autoCheckout      Boolean       @default(false)
  // Çıkış hatırlatması en son ne zaman gönderildi (gün içi tekrar göndermemek için).
  checkoutReminderAt DateTime?
  // Fazla mesai: true ise otomatik çıkış uygulanmaz (kişi geç çıkacak).
  overtime          Boolean       @default(false)
  createdAt         DateTime      @default(now())

  @@index([tenantId, workDate])
  @@index([personnelId, workDate])
  @@map("pdks_attendance_records")
}

model PdksPushSubscription {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      PdksTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personnelId String
  personnel   PdksPersonnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  endpoint    String        @unique
  p256dh      String
  auth        String
  createdAt   DateTime      @default(now())

  @@index([tenantId])
  @@map("pdks_push_subscriptions")
}

// PDKS — Admin-üretimli tek kullanımlık giriş kodu (SMS yok; tenant_admin üretir).
// Login bağlam OLUŞMADAN çalışır → SCOPED değildir, unscoped prisma ile sorgulanır.
model PdksLoginCode {
  id          String        @id @default(cuid())
  tenantId    String
  personnelId String
  personnel   PdksPersonnel @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  codeHash    String // kodun bcrypt hash'i (düz kod saklanmaz)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([personnelId])
  @@index([tenantId])
  @@map("pdks_login_codes")
}

// ═══════════════════════════════════════════════════════════════════════════
// CFO MODÜLÜ — Faz 90
// Alacak/verecek, KMH, kredi kartı, kredi, sabit gider, nakit akışı, gümrük
// rezervi ve net ticari servet takibi.
//
// Tasarım kuralları:
//  - Her finansal veri bir "dataTag" taşır. Rakam asla uydurulmaz; veri yoksa
//    GUNCELLEME_GEREKLI, ödeme günü geçmiş ama bilgi yoksa TEYIT_EDILMELI.
//  - Eski değerler silinmez → CfoChangeLog'a yazılır.
//  - Tablolar cfo_ prefixi ile map'lenir (PDKS modülüyle aynı yaklaşım).
// ═══════════════════════════════════════════════════════════════════════════

enum CfoDataTag {
  KESIN
  TAHMINI
  ESKI
  GUNCELLEME_GEREKLI
  TEYIT_EDILMELI
}

enum CfoCertainty {
  KESIN
  TAHMINI
}

enum CfoLoanStatus {
  AKTIF
  KAPANDI
  BEKLEMEDE
}

enum CfoPaymentStatus {
  ODENDI
  ODENMEDI
  TEYIT_EDILMELI
  KISMI_ODENDI
}

enum CfoEventKind {
  TAHSILAT
  KREDI_TAKSITI
  KART_ODEMESI
  SABIT_GIDER
  KMH
  VERGI_GUMRUK
  DIGER
}

enum CfoImportStatus {
  PLANLANDI
  YOLDA
  GUMRUKTE
  TESLIM_ALINDI
  IPTAL
}

/// Tekil ayar kaydı — tüm CFO hesaplarının parametreleri buradan gelir.
model CfoSettings {
  id                    String   @id @default(cuid())
  usdTryRate            Decimal  @default(45) @db.Decimal(10, 4)
  usdRmbRate            Decimal  @default(7) @db.Decimal(10, 4)
  kmhMonthlyRatePct     Decimal  @default(4.5) @db.Decimal(6, 3) // KMH + kart taşıma maliyeti
  cardMinPct            Decimal  @default(20) @db.Decimal(6, 3) // asgari ödeme oranı varsayımı
  marketplaceTermDays   Int      @default(30)
  cashConversionPct     Decimal  @default(70) @db.Decimal(6, 3) // ciro → nakit oranı
  customsReserveTarget  Decimal? @db.Decimal(14, 2)
  customsReserveDate    DateTime?
  customsReserveSaved   Decimal  @default(0) @db.Decimal(14, 2)
  usdWealthTarget       Decimal? @db.Decimal(14, 2) // ana hedef (örn 300.000 USD)
  wealthTargetDate      DateTime?
  last14dRevenueTry     Decimal? @db.Decimal(14, 2)
  last14dRevenueDate    DateTime?
  monthlyRevenueTarget1 Decimal? @db.Decimal(14, 2)
  monthlyRevenueTarget2 Decimal? @db.Decimal(14, 2)
  stockCostUsd          Decimal? @db.Decimal(14, 2) // satılabilir stok maliyeti
  blockedStockUsd       Decimal? @db.Decimal(14, 2) // Romanya bloke stok
  stockCoverMonths      Decimal? @db.Decimal(6, 2)
  updatedAt             DateTime @updatedAt
  updatedByEmail        String?

  @@map("cfo_settings")
}

/// Banka hesapları ve KMH limitleri. Negatif bakiye = kullanılan KMH.
model CfoBankAccount {
  id             String     @id @default(cuid())
  name           String
  accountType    String     @default("Vadesiz + KMH")
  balanceTry     Decimal?   @db.Decimal(14, 2)
  kmhLimitTry    Decimal    @default(0) @db.Decimal(14, 2)
  monthlyRatePct Decimal?   @db.Decimal(6, 3) // boşsa CfoSettings.kmhMonthlyRatePct
  dataTag        CfoDataTag @default(KESIN)
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  note           String?
  lastUpdatedAt  DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isActive])
  @@map("cfo_bank_account")
}

/// Kredi kartları. Asgari tutar borç × CfoSettings.cardMinPct ile TAHMİNİ hesaplanır;
/// gerçek ekstre asgarisi biliniyorsa minOverrideTry doldurulur.
model CfoCreditCard {
  id                String           @id @default(cuid())
  bank              String
  holder            String?
  statementDebtTry  Decimal?         @db.Decimal(14, 2)
  totalDebtTry      Decimal?         @db.Decimal(14, 2)
  fxDebtUsd         Decimal?         @db.Decimal(12, 2)
  statementDay      Int? // ayın kaçında kesim
  dueDay            Int? // ayın kaçında son ödeme
  minOverrideTry    Decimal?         @db.Decimal(14, 2)
  currentMonthState CfoPaymentStatus @default(TEYIT_EDILMELI)
  nextDueDate       DateTime?
  dataTag           CfoDataTag       @default(KESIN)
  sortOrder         Int              @default(0)
  isActive          Boolean          @default(true)
  note              String?
  lastUpdatedAt     DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([isActive])
  @@map("cfo_credit_card")
}

/// Krediler. KAPANDI olanlar borç servisi toplamına dahil edilmez.
model CfoLoan {
  id                  String           @id @default(cuid())
  bank                String
  name                String
  principalTry        Decimal?         @db.Decimal(14, 2)
  remainingTry        Decimal?         @db.Decimal(14, 2)
  earlyPayoffTry      Decimal?         @db.Decimal(14, 2)
  monthlyPaymentTry   Decimal?         @db.Decimal(14, 2)
  paymentDay          Int?
  totalInstallments   Int? // toplam taksit sayısı (ör. 24)
  remainingOverride   Int? // düzensiz ödeme planlarında kalan taksit elle girilir; boşsa tarihlerden hesaplanır
  lastInstallmentDate DateTime? // = kredi bitiş tarihi
  nextPaymentDate     DateTime?
  interestRatePct     Decimal?         @db.Decimal(6, 3) // aylık faiz — boşsa erken kapama ROI'si hesaplanamaz
  currentMonthState   CfoPaymentStatus @default(TEYIT_EDILMELI)
  status              CfoLoanStatus    @default(AKTIF)
  priority            String? // Yüksek | Orta | Düşük
  strategy            String?
  dataTag             CfoDataTag       @default(KESIN)
  sortOrder           Int              @default(0)
  note                String?
  lastUpdatedAt       DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@map("cfo_loan")
}

/// Aylık sabit giderler. Kredi taksiti ve kart ödemesi BURAYA GİRMEZ (çift sayım).
model CfoFixedExpense {
  id            String     @id @default(cuid())
  name          String
  category      String?
  monthlyTry    Decimal    @db.Decimal(14, 2)
  paymentDay    Int?
  isActive      Boolean    @default(true)
  dataTag       CfoDataTag @default(KESIN)
  sortOrder     Int        @default(0)
  note          String?
  lastUpdatedAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([isActive])
  @@map("cfo_fixed_expense")
}

/// Pazaryeri hakediş takvimi — gerçek tarihli, kesin tutarlı alacaklar.
/// Haftalık (ciro/4) tahmini bu kayıtlarla ÇAKIŞMAZ: motor aynı haftadaki
/// gerçek hakedişi brüt tahminden düşer.
model CfoReceivable {
  id          String       @id @default(cuid())
  channel     String
  dueDate     DateTime
  amountTry   Decimal      @db.Decimal(14, 2)
  certainty   CfoCertainty @default(KESIN)
  isCollected Boolean      @default(false)
  source      String? // örn "Trendyol ödemeler ekranı 24.08.2026"
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([dueDate])
  @@index([channel])
  @@index([isCollected])
  @@map("cfo_receivable")
}

/// Nakit akışı olay tablosu — 7/30/60/90 gün rolling forecast bunun üzerinden.
model CfoCashEvent {
  id             String       @id @default(cuid())
  eventDate      DateTime
  kind           CfoEventKind
  description    String
  bank           String?
  inflowTry      Decimal?     @db.Decimal(14, 2)
  outflowTry     Decimal?     @db.Decimal(14, 2)
  certainty      CfoCertainty @default(TAHMINI)
  relatedDebt    String?
  relatedImport  String?
  relatedChannel String?
  isSettled      Boolean      @default(false)
  autoGenerated  Boolean      @default(false) // tekrarlayan üreticiden geldiyse
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([eventDate])
  @@index([kind])
  @@map("cfo_cash_event")
}

/// İthalat partileri — yoldaki stok ve gümrük yükümlülüğü.
model CfoImportProject {
  id                 String          @id @default(cuid())
  code               String          @unique
  status             CfoImportStatus @default(YOLDA)
  etaDate            DateTime?
  totalCostUsd       Decimal?        @db.Decimal(14, 2)
  paidUsd            Decimal?        @db.Decimal(14, 2)
  customsEstimateTry Decimal?        @db.Decimal(14, 2)
  expectedRevenueTry Decimal?        @db.Decimal(14, 2)
  expectedProfitTry  Decimal?        @db.Decimal(14, 2)
  salesMonths        Decimal?        @db.Decimal(6, 2)
  dataTag            CfoDataTag      @default(TAHMINI)
  note               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@map("cfo_import_project")
}

/// Günlük/olay bazlı net ticari servet snapshot'ı — trend buradan çıkar.
model CfoSnapshot {
  id             String   @id @default(cuid())
  takenAt        DateTime @default(now())
  netWorthTry    Decimal  @db.Decimal(14, 2)
  netWorthUsd    Decimal  @db.Decimal(14, 2)
  wideWorthTry   Decimal? @db.Decimal(14, 2)
  wideWorthUsd   Decimal? @db.Decimal(14, 2)
  cashTry        Decimal? @db.Decimal(14, 2)
  receivablesTry Decimal? @db.Decimal(14, 2)
  stockTry       Decimal? @db.Decimal(14, 2)
  debtTry        Decimal? @db.Decimal(14, 2)
  usdTryRate     Decimal? @db.Decimal(10, 4)
  note           String?

  @@index([takenAt])
  @@map("cfo_snapshot")
}

/// Değişim logu — eski değer asla silinmez.
model CfoChangeLog {
  id        String   @id @default(cuid())
  changedAt DateTime @default(now())
  area      String // örn "cfo_bank_account"
  item      String // örn "Akbank Alp KMH limiti"
  oldValue  String?
  newValue  String?
  source    String? // "Kullanıcı", "Trendyol ekran görüntüsü", "Sistem"
  note      String?

  @@index([changedAt])
  @@index([area])
  @@map("cfo_change_log")
}
