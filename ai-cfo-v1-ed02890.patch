+name: AI CFO validation
+on:
+  pull_request:
+  push:
+    branches: [feat/ai-cfo-v1]
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: ai-cfo-validation-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  validate:
+    runs-on: ubuntu-latest
